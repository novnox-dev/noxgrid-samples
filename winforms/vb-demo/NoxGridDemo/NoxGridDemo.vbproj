    <ProjectGuid>{CB33EC57-6702-413F-AF47-EB54BECBED62}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <StartupObject>NoxGridDemo.Program</StartupObject>
    <RootNamespace>NoxGridDemo</RootNamespace>
    <AssemblyName>NoxGridDemo</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <!-- VB language level of Visual Studio 2019 -->
